#define ZMK_POINTING_DEFAULT_MOVE_VAL 600  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/naginata.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <750>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    macros {
        to_ng: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LANGUAGE_1 &kp INTERNATIONAL_4 &to 1>,
                <&macro_press>,
                <&kp LALT &kp LSHIFT>,
                <&macro_tap>,
                <&kp NUMBER_1>,
                <&macro_release>,
                <&kp LALT &kp LSHIFT>;
        };

        to_colemak: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LANGUAGE_2 &kp INTERNATIONAL_5 &to 0>,
                <&macro_press>,
                <&kp LALT &kp LSHIFT>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_release>,
                <&kp LALT &kp LSHIFT>;
        };

        tog_ime: tog_ime {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "TOG_IME";
        };
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        combo_ng_on {
            timeout-ms = <300>;
            key-positions = <42 47>;
            bindings = <&to_ng>;
            layers = <0>;
        };

        combo_to_eng {
            timeout-ms = <300>;
            key-positions = <42 47>;
            bindings = <&to_colemak>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp F         &kp P  &kp B                                &kp UP                &kp J        &kp L  &kp U         &kp Y    &kp SEMICOLON  &kp BACKSPACE
&kp TAB    &kp A  &kp R  &kp S         &kp T  &kp G                      &kp LEFT  &kp ENTER  &kp RIGHT  &kp M        &kp N  &kp E         &kp I    &kp O          &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C         &kp D  &kp V        &kp C_MUTE              &kp DOWN              &kp K        &kp H  &kp COMMA     &kp DOT  &kp FSLH       &kp DELETE
                         &kp LEFT_ALT  &td0   &lt 4 SPACE                                                &lt 3 ENTER  &mo 2  &kp LEFT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        japanese_layer {
            display-name = "NAGINATA";
            bindings = <
&kp ESCAPE        &ng Q  &ng W  &ng E     &ng R  &ng T                                    &mmv MOVE_UP                     &ng Y      &ng U  &ng I         &ng O    &ng P      &kp BACKSPACE
&kp INT_MUHENKAN  &ng A  &ng S  &ng D     &ng F  &ng G                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &ng H      &ng J  &ng K         &ng L    &ng SEMI   &kp INT_HENKAN
&kp LCTRL         &ng Z  &ng X  &ng C     &ng V  &ng B      &kp C_MUTE                    &mmv MOVE_DOWN                   &ng N      &ng M  &ng COMMA     &ng DOT  &ng SLASH  &kp DEL
                                &tog_ime  &td0   &ng SPACE                                                                 &ng ENTER  &mo 2  &kp LEFT_WIN
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        raise_layer {
            display-name = "NUM&SYMBOL";
            bindings = <
&kp GRAVE  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ASTERISK  &kp EXCLAMATION  &kp PERCENT                            &mmv MOVE_UP                     &kp DOLLAR     &kp KP_N7        &kp KP_N8  &kp KP_N9  &kp KP_NUMLOCK  &trans
&kp TILDE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL     &kp MINUS        &kp AT_SIGN            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp HASH       &kp KP_N4        &kp KP_N5  &kp KP_N6  &kp KP_N0       &kp PIPE
&trans     &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS      &kp UNDERSCORE   &kp CARET    &trans                    &mmv MOVE_DOWN                   &kp AMPERSAND  &kp KP_NUMBER_1  &kp KP_N2  &kp KP_N3  &kp BACKSLASH   &trans
                                                        &trans        &trans           &trans                                                                  &trans         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "Fn";
            bindings = <
&trans                        &rgb_ug RGB_COLOR_HSB(243,100,50)  &rgb_ug RGB_COLOR_HSB(124,100,50)  &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_COLOR_HSB(0,0,100)  &trans                                       &kp C_BRI_INC                   &bt BT_SEL 0  &kp F1  &kp F2   &kp F3   &kp F4   &trans
&rgb_ug RGB_COLOR_HSB(0,0,0)  &rgb_ug RGB_SAI                    &rgb_ug RGB_SPI                    &rgb_ug RGB_BRI                  &rgb_ug RGB_TOG                 &out OUT_TOG              &kp C_VOLUME_DOWN  &kp C_MUTE     &kp C_VOLUME_UP  &bt BT_SEL 1  &kp F5  &kp F6   &kp F7   &kp F8   &kp SCROLLLOCK
&trans                        &rgb_ug RGB_SAD                    &rgb_ug RGB_SPD                    &rgb_ug RGB_BRD                  &rgb_ug RGB_EFF                 &bt BT_CLR_ALL  &trans                       &kp C_BRI_DEC                   &bt BT_SEL 2  &kp F9  &kp F10  &kp F11  &kp F12  &trans
                                                                                                    &trans                           &trans                          &trans                                                                       &trans        &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        deep_layer {
            display-name = "NAVIGATION";
            bindings = <
&trans           &tog 5     &kp HOME  &kp UP    &kp END    &trans                    &trans          &trans  &kp HOME  &kp UP    &kp END    &tog 5     &trans
&kp PRINTSCREEN  &kp PG_UP  &kp LEFT  &kp DOWN  &kp RIGHT  &trans            &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_UP  &kp PRINTSCREEN
&trans           &kp PG_DN  &kp BSPC  &kp INS   &kp DEL    &trans  &trans            &trans          &trans  &kp BSPC  &kp INS   &kp DEL    &kp PG_DN  &trans
                                      &trans    &trans     &trans                                    &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp U D>;
        };

        mouse_state_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;

            label = "COLEMAK*";
        };

        mouse_active_layer {
            bindings = <
&trans  &tog 5          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans                             &trans          &trans           &mkp MB4        &mmv MOVE_UP    &mkp MB5         &tog 5          &trans
&trans  &msc SCRL_UP    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_LEFT             &trans  &trans  &trans  &msc SCRL_RIGHT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP    &trans
&trans  &msc SCRL_DOWN  &mkp RCLK       &mkp MCLK       &mkp LCLK        &msc SCRL_RIGHT  &trans            &trans          &msc SCRL_LEFT   &mkp LCLK       &mkp MCLK       &mkp RCLK        &msc SCRL_DOWN  &trans
                                        &trans          &trans           &trans                                             &trans           &trans          &trans
            >;

            label = "MOUSE";
            sensor-bindings = <&inc_dec_kp A B>;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                                    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mouse_conditional {
            if-layers = <4 5>;
            then-layer = <6>;
        };
    };
};
